PORT=3001
NODE_ENV=development
AUTH_MODE=demo
CORS_ORIGINS=http://localhost:3000
# 仅非生产环境生效；只提供 OpenAPI JSON，不挂载内嵌 Swagger UI。
SWAGGER_ENABLED=true
# readiness 对数据库、Redis 单项检查的超时。
HEALTH_CHECK_TIMEOUT_MS=2000

# ---- Audit / operations / alerts ----
# 运维端点 `/api/operations/*` 的独立 Bearer token；生产至少 32 字符。
OPERATIONS_TOKEN=
# 告警 Webhook 必须为 HTTPS；请求体使用 HMAC-SHA256 签名。
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_MS=3000
ALERT_WEBHOOK_MAX_ATTEMPTS=3
ALERT_WEBHOOK_RETRY_BASE_MS=500
ALERT_RENOTIFY_SECONDS=900
ALERT_MONITOR_INTERVAL_MS=60000
ALERT_QUEUE_BACKLOG_THRESHOLD=20
ALERT_QUEUE_MAX_AGE_SECONDS=300
ALERT_ERROR_RATE_PERCENT=5
ALERT_ERROR_RATE_MIN_REQUESTS=20
# 可选；未设置时使用 ENCRYPTION_KEY 作为 IP HMAC salt。
AUDIT_HASH_SALT=
AUDIT_RETENTION_DAYS=180

# ---- Database (Supabase / Postgres) ----
# 运行时（连接池 / pgbouncer）：6543 端口
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# 迁移 / introspect 用直连：5432 端口
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# 本地开发（docker compose 起 Postgres）
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplier
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/supplier

REDIS_URL=redis://localhost:6379

# Platform OpenAPI
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_OAUTH_REDIRECT_URI=http://localhost:3001/api/shops/oauth/alibaba_1688/callback
# 真实货源采集硬门禁：只有验证不同买家账号返回的 offer 价格/库存一致后才设为 global_offer。
ALIBABA_1688_SOURCE_DATA_SCOPE=
# 首期只支持 manual：创建采购单后由人工确认支付，不启用免密扣款。
ALIBABA_1688_PAYMENT_MODE=manual
# 真实下单总开关：只有准备度全部通过后才可手工改为 true。
ALIBABA_1688_PURCHASE_ENABLED=false
# 已回传抖店的 1688 采购后台巡检；需同时开启真实采购总开关。
ALIBABA_1688_PURCHASE_AUDIT_ENABLED=false
ALIBABA_1688_PURCHASE_AUDIT_INTERVAL_MS=300000
ALIBABA_1688_PURCHASE_AUDIT_BATCH_SIZE=100
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_SERVICE_ID=
DOUYIN_CUSTOMER_MOBILE=
DOUYIN_OAUTH_REDIRECT_URI=http://localhost:3001/api/shops/oauth/douyin/callback
# 抖店目前使用正式 OpenAPI + 测试店铺，不切换独立 sandbox 域名。
DOUYIN_OAUTH_SANDBOX=false
# 真实抖店订单后台增量同步；完成真实店联调后再启用。
DOUYIN_ORDER_SYNC_ENABLED=false
DOUYIN_ORDER_SYNC_INTERVAL_MS=60000
DOUYIN_ORDER_SYNC_LOOKBACK_DAYS=30
DOUYIN_ORDER_SYNC_OVERLAP_SECONDS=300
# 单轮最多 100 页 × 100 单；超过时不推进同步水位，需调大后重试。
DOUYIN_ORDER_SYNC_MAX_PAGES=100
# 1688 采集写入库存快照后，异步同步抖店库存；真实店联调完成前保持关闭。
INVENTORY_SYNC_ENABLED=false
INVENTORY_SYNC_POLL_MS=5000
INVENTORY_SYNC_MAX_ATTEMPTS=3

# 持久化批量商品任务；应用最新 migration 后再启用。
PRODUCT_BATCH_ENABLED=false
PRODUCT_BATCH_POLL_MS=2000
PRODUCT_BATCH_MAX_ATTEMPTS=3
# 持久化 1688 货源采集任务；与批量铺货独立启停。
SOURCE_IMPORT_ENABLED=false
SOURCE_IMPORT_POLL_MS=2000
SOURCE_IMPORT_MAX_ATTEMPTS=3
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=

# OAuth security
# Exact callback URLs only, comma-separated. Production callbacks must use HTTPS.
OAUTH_CALLBACK_ALLOWLIST=http://localhost:3001/api/shops/oauth/douyin/callback,http://localhost:3001/api/shops/oauth/alibaba_1688/callback
OAUTH_STATE_TTL_SECONDS=300
# OAuth 完成后回到 Web 设置页；生产环境必须为 HTTPS。
OAUTH_RESULT_REDIRECT_URL=http://localhost:3000/settings

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Crypto
ENCRYPTION_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# AI 详情长图（Supabase Storage；bucket 必须允许公开读取）
SUPABASE_URL=https://[PROJECT_REF].supabase.co
# 优先使用 Supabase 的 sb_secret_* Key；禁止把该值暴露给 Web。
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=supplier-assets
# Supabase Auth：生产 AUTH_MODE=supabase。默认通过 JWKS 验签；旧项目仍使用 HS256 时填写 JWT secret。
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# GPU 主图处理服务（YOLO → Inpaint → SAM2 → 背景模板 → VLM 审核）
IMAGE_PIPELINE_URL=https://image-worker.example.com/v1/images/process
IMAGE_PIPELINE_API_KEY=

# 铺货执行：默认 database；仅本地排障时可临时改为 inline
PUBLISH_QUEUE_MODE=database
PUBLISH_QUEUE_POLL_MS=2000
PUBLISH_MAX_ATTEMPTS=3
