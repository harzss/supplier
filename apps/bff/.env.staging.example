PORT=3001
NODE_ENV=production
AUTH_MODE=supabase
CORS_ORIGINS=https://supplier-staging-web.ACCOUNT.workers.dev
WEB_URL=https://supplier-staging-web.ACCOUNT.workers.dev
SWAGGER_ENABLED=false
HEALTH_CHECK_TIMEOUT_MS=8000

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
REDIS_URL=redis://127.0.0.1:6379

ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OPERATIONS_TOKEN=replace-with-an-independent-32-character-token
ALERT_WEBHOOK_URL=https://supplier-staging-gateway.ACCOUNT.workers.dev/_supplier/alerts
ALERT_WEBHOOK_SECRET=replace-with-the-same-32-character-cloudflare-secret

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-secret-key
SUPABASE_STORAGE_BUCKET=supplier-assets
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

PUBLISH_QUEUE_MODE=database
DOUYIN_ORDER_SYNC_ENABLED=false
INVENTORY_SYNC_ENABLED=false
PRODUCT_BATCH_ENABLED=false
PRODUCT_BATCH_POLL_MS=2000
PRODUCT_BATCH_MAX_ATTEMPTS=3
ALIBABA_1688_PURCHASE_ENABLED=false
ALIBABA_1688_PURCHASE_AUDIT_ENABLED=false
ALIBABA_1688_PAYMENT_MODE=manual

OAUTH_CALLBACK_ALLOWLIST=https://supplier-staging-gateway.ACCOUNT.workers.dev/api/shops/oauth/douyin/callback,https://supplier-staging-gateway.ACCOUNT.workers.dev/api/shops/oauth/alibaba_1688/callback
OAUTH_RESULT_REDIRECT_URL=https://supplier-staging-web.ACCOUNT.workers.dev/settings
DOUYIN_OAUTH_REDIRECT_URI=https://supplier-staging-gateway.ACCOUNT.workers.dev/api/shops/oauth/douyin/callback
ALIBABA_1688_OAUTH_REDIRECT_URI=https://supplier-staging-gateway.ACCOUNT.workers.dev/api/shops/oauth/alibaba_1688/callback

DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_SERVICE_ID=
DOUYIN_CUSTOMER_MOBILE=
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
IMAGE_PIPELINE_URL=
IMAGE_PIPELINE_API_KEY=
