NEXT_PUBLIC_BFF_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Supplier
# 生产环境必须为 supabase，且 BFF/Supabase URL 必须使用 HTTPS origin。
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_SIGNUP_ENABLED=false
NEXT_PUBLIC_AUDIT_TEST_MODE=false
# 法务、主体、客服与公开文案全部签字前保持 false。
NEXT_PUBLIC_LEGAL_PAGES_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
# 优先使用 Supabase 的 sb_publishable_* Key；禁止填入 sb_secret_*。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
