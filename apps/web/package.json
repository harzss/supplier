{
  "name": "@supplier/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "cf:build": "pnpm clean && pnpm --filter @supplier/shared-types build && WEB_BUILD_TARGET=static next build",
    "cf:preview": "pnpm cf:build && wrangler dev",
    "cf:dry-run": "pnpm cf:build && wrangler deploy --dry-run",
    "cf:deploy": "pnpm cf:build && wrangler deploy",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --api.host=127.0.0.1",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo out"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@supplier/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "next": "15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
