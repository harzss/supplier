{
  "name": "supplier",
  "version": "0.0.1",
  "private": true,
  "description": "Simple, safe, and transparent 1688 distribution operations platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.6": "5.0.9",
      "fast-uri@3.1.2": "3.1.4",
      "fast-uri@4.1.0": "4.1.2",
      "find-my-way@9.6.0": "9.7.0",
      "js-yaml@5.2.1": "5.2.3",
      "postcss@<8.5.18": "8.5.25",
      "sharp@<0.35.0": "0.35.3"
    }
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/supplier DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/supplier REDIS_URL=redis://127.0.0.1:6379 playwright test",
    "test:ops": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm --filter @supplier/db prisma:generate && turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "llm:test": "node scripts/test-llm.mjs",
    "db:dev:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait postgres redis",
    "db:migrate": "pnpm db:dev:up && pnpm --filter @supplier/db prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @supplier/db prisma:migrate:deploy",
    "db:migrate:status": "pnpm --filter @supplier/db prisma:migrate:status",
    "db:studio": "pnpm --filter @supplier/db prisma:studio",
    "db:seed": "node scripts/seed.mjs",
    "audit:supabase-boundary": "node scripts/verify-supabase-boundary.mjs",
    "audit:supabase-boundary:publishable": "node scripts/verify-supabase-boundary.mjs --require-publishable-key",
    "audit:supabase-key-rotation": "node scripts/verify-supabase-key-rotation.mjs",
    "audit:supabase-auth-session": "node scripts/verify-supabase-auth-session.mjs",
    "audit:supabase-auth-password-transition": "node scripts/verify-supabase-auth-session.mjs --expect-previous-password-rejected",
    "staging:auth:invite": "node scripts/invite-staging-user.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "staging:supervise": "node scripts/staging-local-supervisor.mjs",
    "staging:launchagent:install": "node scripts/install-staging-launchagent.mjs",
    "score": "node scripts/score-products.mjs",
    "crawl": "node scripts/crawl-products.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "wrangler": "4.118.0"
  }
}
