// Prisma schema mirrors docs/04-data-model.md
// 数据库：Supabase (PostgreSQL 15+)
// - DATABASE_URL  : 连接池地址（pgbouncer，runtime 用）
// - DIRECT_URL    : 直连地址（迁移 / introspect 用）
//
// 1688 货源大表（source_products）若量级达到亿级，可后续按 category_l1 分区或迁到独立 Citus / 自建 PG 集群。

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// BFF-only short-lived coordination state stored in Supabase PostgreSQL.
// Client-facing Supabase roles have no privileges or RLS policies on this table.
model RuntimeState {
  key          String   @id @db.VarChar(255)
  value        Json?    @db.JsonB
  ownerToken   String?  @map("owner_token") @db.Uuid
  counterValue Int?     @map("counter_value")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("runtime_states")
}

// ----- 用户与店铺 -----

enum UserPlan {
  free
  basic
  pro
  flagship
  enterprise
}

enum UserStatus {
  active
  disabled
}

enum EntitlementSource {
  internal_beta
  marketplace
}

enum EntitlementAccessStatus {
  active
  suspended
}

model User {
  id                      BigInt                  @id @default(autoincrement())
  authSubject             String?                 @unique @map("auth_subject") @db.Uuid
  phone                   String?                 @unique @db.VarChar(20)
  wechatUnionid           String?                 @unique @map("wechat_unionid") @db.VarChar(64)
  nickname                String?                 @db.VarChar(64)
  avatarUrl               String?                 @map("avatar_url") @db.VarChar(512)
  plan                    UserPlan                @default(free)
  status                  UserStatus              @default(active)
  entitlementSource       EntitlementSource       @default(internal_beta) @map("entitlement_source")
  entitlementAccessStatus EntitlementAccessStatus @default(active) @map("entitlement_access_status")
  entitlementRevision     Int                     @default(1) @map("entitlement_revision")
  entitlementUpdatedAt    DateTime                @default(now()) @map("entitlement_updated_at") @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  shops                         Shop[]
  publishDraft                  PublishDraft?
  publishTasks                  PublishTask[]
  productBatchTasks             ProductBatchTask[]
  sourceImportTasks             SourceImportTask[]
  userSourceProducts            UserSourceProduct[]
  favorites                     UserFavorite[]
  aiUsageLogs                   AiUsageLog[]
  subscriptions                 Subscription[]
  llmCredential                 LlmCredential?
  categoryMappings              ProductCategoryMapping[]
  categoryPropertyMappings      ProductCategoryPropertyMapping[]
  categoryQualificationMappings ProductCategoryQualificationMapping[]
  skuMappings                   ProductSkuMapping[]
  auditLogs                     AuditLog[]
  purchaseRecoveries            PurchaseOrderRecovery[]
  orderLogisticsRepairs         OrderLogisticsRepair[]
  exceptionCases                ExceptionCase[]                       @relation("ExceptionCaseOwner")
  acknowledgedExceptionCases    ExceptionCase[]                       @relation("ExceptionCaseAcknowledgedBy")
  exceptionCaseEvents           ExceptionCaseEvent[]                  @relation("ExceptionCaseEventActor")
  afterSaleCases                AfterSaleCase[]                       @relation("AfterSaleCaseOwner")
  assignedAfterSaleCases        AfterSaleCase[]                       @relation("AfterSaleCaseAssignee")
  closedAfterSaleCases          AfterSaleCase[]                       @relation("AfterSaleCaseClosedBy")
  confirmedAfterSaleLinks       AfterSalePurchaseLink[]               @relation("AfterSalePurchaseLinkConfirmedBy")
  afterSaleCaseEvents           AfterSaleCaseEvent[]                  @relation("AfterSaleCaseEventActor")
  marketplaceAccountBindings    MarketplaceAccountBinding[]
  marketplaceProjections        MarketplaceSubscriptionProjection[]

  @@index([plan])
  @@index([entitlementSource, entitlementAccessStatus])
  @@map("users")
}

enum Platform {
  alibaba_1688
  taobao
  tmall
  douyin
  pdd
  kuaishou
  wechat_shop
}

enum ShopRole {
  seller
  buyer
}

enum ShopStatus {
  active
  expired
  revoked
}

model Shop {
  id                 BigInt     @id @default(autoincrement())
  userId             BigInt     @map("user_id")
  platform           Platform
  platformShopId     String     @map("platform_shop_id") @db.VarChar(64)
  shopName           String?    @map("shop_name") @db.VarChar(128)
  role               ShopRole   @default(seller)
  accessTokenEnc     String?    @map("access_token_enc") @db.VarChar(1024)
  refreshTokenEnc    String?    @map("refresh_token_enc") @db.VarChar(1024)
  tokenExpireAt      DateTime?  @map("token_expire_at")
  status             ShopStatus @default(active)
  lastOrderSyncAt    DateTime?  @map("last_order_sync_at")
  orderSyncAttemptAt DateTime?  @map("order_sync_attempt_at")
  orderSyncError     String?    @map("order_sync_error") @db.VarChar(500)
  createdAt          DateTime   @default(now()) @map("created_at")

  user                          User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedProducts             PublishedProduct[]
  orders                        Order[]
  buyerPurchaseOrders           PurchaseOrder[]                       @relation("PurchaseBuyerShop")
  sourceImportTasks             SourceImportTask[]                    @relation("SourceImportBuyerShop")
  categoryCatalog               ShopCategory[]
  categoryPropertyMappings      ProductCategoryPropertyMapping[]
  categoryQualificationMappings ProductCategoryQualificationMapping[]

  @@unique([userId, platform, platformShopId], name: "uk_user_platform_shop")
  @@index([userId])
  @@map("shops")
}

// 授权店铺当前可用的官方商品类目目录；每次完整同步在事务内整体替换。
model ShopCategory {
  id                        BigInt    @id @default(autoincrement())
  shopId                    BigInt    @map("shop_id")
  channel                   Int       @default(0)
  categoryId                String    @map("category_id") @db.VarChar(64)
  name                      String    @db.VarChar(128)
  parentId                  String?   @map("parent_id") @db.VarChar(64)
  path                      String    @db.VarChar(512)
  level                     Int
  isLeaf                    Boolean   @map("is_leaf")
  enabled                   Boolean   @default(true)
  attributes                Json?     @db.JsonB
  attributesFingerprint     String?   @map("attributes_fingerprint") @db.VarChar(64)
  attributesSyncedAt        DateTime? @map("attributes_synced_at")
  qualifications            Json?     @db.JsonB
  qualificationsFingerprint String?   @map("qualifications_fingerprint") @db.VarChar(64)
  qualificationsSyncedAt    DateTime? @map("qualifications_synced_at")
  syncedAt                  DateTime  @default(now()) @map("synced_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, channel, categoryId], name: "uk_shop_channel_category", map: "uk_shop_channel_category")
  @@index([shopId, channel, isLeaf, enabled])
  @@index([shopId, channel, parentId])
  @@map("shop_categories")
}

// ----- 货源与选品 -----

enum SourceProductAvailability {
  available
  out_of_stock
  offline
  unknown
}

model SourceProduct {
  id                    BigInt                    @id @default(autoincrement())
  productId1688         String                    @unique @map("product_id_1688") @db.VarChar(32)
  supplierId            String?                   @map("supplier_id") @db.VarChar(32)
  title                 String                    @db.VarChar(255)
  price                 Decimal                   @db.Decimal(10, 2)
  priceMin              Decimal?                  @map("price_min") @db.Decimal(10, 2)
  priceMax              Decimal?                  @map("price_max") @db.Decimal(10, 2)
  mainImage             String?                   @map("main_image") @db.VarChar(512)
  detailImages          Json?                     @map("detail_images") @db.JsonB
  categoryPath          String?                   @map("category_path") @db.VarChar(255)
  categoryL1            String?                   @map("category_l1") @db.VarChar(64)
  categoryL2            String?                   @map("category_l2") @db.VarChar(64)
  skuList               Json?                     @map("sku_list") @db.JsonB
  attributes            Json?                     @db.JsonB
  monthlySold           Int                       @default(0) @map("monthly_sold")
  isCrossBorder         Boolean                   @default(false) @map("is_cross_border")
  isOnePieceDrop        Boolean                   @default(false) @map("is_one_piece_drop")
  availability          SourceProductAvailability @default(unknown)
  totalStock            Int                       @default(0) @map("total_stock")
  inventoryFingerprint  String                    @default("legacy") @map("inventory_fingerprint") @db.VarChar(64)
  inventoryVersion      Int                       @default(0) @map("inventory_version")
  availabilityChangedAt DateTime                  @default(now()) @map("availability_changed_at")
  syncedAt              DateTime                  @default(now()) @map("synced_at")

  score                          ProductScore?
  publishDrafts                  PublishDraft[]
  publishTasks                   PublishTask[]
  publishedProducts              PublishedProduct[]
  favorites                      UserFavorite[]
  categoryMappings               ProductCategoryMapping[]
  categoryPropertyMappings       ProductCategoryPropertyMapping[]
  categoryQualificationMappings  ProductCategoryQualificationMapping[]
  skuMappings                    ProductSkuMapping[]
  sourceImportItems              SourceImportItem[]
  userSourceProducts             UserSourceProduct[]
  publishedProductSourceBindings PublishedProductSourceBinding[]

  @@index([categoryL1])
  @@index([availability])
  @@index([syncedAt])
  @@map("source_products")
}

model ProductScore {
  productId        BigInt   @id @map("product_id")
  demandScore      Float    @map("demand_score")
  competitionScore Float    @map("competition_score")
  profitScore      Float    @map("profit_score")
  complianceScore  Float    @map("compliance_score")
  trendScore       Float    @map("trend_score")
  overallScore     Float    @map("overall_score")
  reason           Json     @db.JsonB
  features         Json     @db.JsonB
  scoredAt         DateTime @default(now()) @map("scored_at")

  product SourceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([overallScore(sort: Desc)])
  @@map("product_scores")
}

model UserFavorite {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  sourceProductId BigInt   @map("source_product_id")
  folderName      String   @default("default") @map("folder_name") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceProductId])
  @@map("user_favorites")
}

// 用户采集箱归属。SourceProduct 仍是全局 offer 缓存；本表只表达哪个用户采集过该货源，
// 不代表收藏，也不自动触发评分。
model UserSourceProduct {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  sourceProductId  BigInt   @map("source_product_id")
  firstCollectedAt DateTime @default(now()) @map("first_collected_at")
  lastCollectedAt  DateTime @default(now()) @map("last_collected_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct     SourceProduct      @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)
  sourceImportItems SourceImportItem[]

  @@unique([userId, sourceProductId], name: "uk_user_source_product", map: "user_source_products_user_source_product_key")
  @@index([userId, lastCollectedAt(sort: Desc)])
  @@index([sourceProductId])
  @@map("user_source_products")
}

// 用户确认的平台叶子类目映射；避免把单个用户的选择写回全局货源 attributes。
model ProductCategoryMapping {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  sourceProductId BigInt   @map("source_product_id")
  platform        Platform
  categoryId      String   @map("category_id") @db.VarChar(64)
  categoryName    String?  @map("category_name") @db.VarChar(128)
  confirmedAt     DateTime @default(now()) @map("confirmed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceProductId, platform], name: "uk_user_product_platform_category", map: "uk_user_product_platform_category")
  @@index([userId, platform])
  @@index([sourceProductId])
  @@map("product_category_mappings")
}

// 用户按目标店铺确认的类目属性；schema 指纹变化后旧确认自动失效。
model ProductCategoryPropertyMapping {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  sourceProductId   BigInt   @map("source_product_id")
  shopId            BigInt   @map("shop_id")
  categoryId        String   @map("category_id") @db.VarChar(64)
  schemaFingerprint String   @map("schema_fingerprint") @db.VarChar(64)
  values            Json     @db.JsonB
  confirmedAt       DateTime @default(now()) @map("confirmed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceProductId, shopId], name: "uk_user_product_shop_category_properties", map: "uk_user_product_shop_category_properties")
  @@index([shopId, categoryId])
  @@index([sourceProductId])
  @@map("product_category_property_mappings")
}

// 用户按目标店铺确认的类目资质；官方 schema 或动态属性要求变化后旧确认自动失效。
model ProductCategoryQualificationMapping {
  id                     BigInt   @id @default(autoincrement())
  userId                 BigInt   @map("user_id")
  sourceProductId        BigInt   @map("source_product_id")
  shopId                 BigInt   @map("shop_id")
  categoryId             String   @map("category_id") @db.VarChar(64)
  schemaFingerprint      String   @map("schema_fingerprint") @db.VarChar(64)
  requirementFingerprint String   @map("requirement_fingerprint") @db.VarChar(64)
  values                 Json     @db.JsonB
  confirmedAt            DateTime @default(now()) @map("confirmed_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceProductId, shopId], name: "uk_user_product_shop_category_qualifications", map: "uk_user_product_shop_category_qualifications")
  @@index([shopId, categoryId])
  @@index([sourceProductId])
  @@map("product_category_qualification_mappings")
}

// 用户确认的平台 SKU 规格映射；源 SKU 变化后通过 fingerprint 使旧确认自动失效。
model ProductSkuMapping {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  sourceProductId   BigInt   @map("source_product_id")
  platform          Platform
  dimensions        Json     @db.JsonB
  skus              Json     @db.JsonB
  sourceFingerprint String   @map("source_fingerprint") @db.VarChar(64)
  confirmedAt       DateTime @default(now()) @map("confirmed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceProductId, platform], name: "uk_user_product_platform_sku")
  @@index([userId, platform])
  @@index([sourceProductId])
  @@map("product_sku_mappings")
}

// ----- 铺货 -----

// 用户当前可编辑的铺货意图；不保存试算凭证、预检结果或平台发布快照。
model PublishDraft {
  userId          BigInt   @id @map("user_id")
  clientRequestId String   @map("client_request_id") @db.Uuid
  sourceProductId BigInt   @map("source_product_id")
  targetShopIds   Json     @default("[]") @map("target_shop_ids") @db.JsonB
  pricingStrategy Json?    @map("pricing_strategy") @db.JsonB
  aiOptions       Json?    @map("ai_options") @db.JsonB
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)

  @@index([sourceProductId])
  @@map("publish_drafts")
}

enum PublishTaskStatus {
  pending
  optimizing
  publishing
  partial
  success
  failed
}

enum PublishJobStatus {
  queued
  running
  retry_wait
  completed
  dead
}

model PublishTask {
  id                            BigInt            @id @default(autoincrement())
  userId                        BigInt            @map("user_id")
  clientRequestId               String?           @map("client_request_id") @db.Uuid
  sourceProductId               BigInt            @map("source_product_id")
  targetShopIds                 Json              @map("target_shop_ids") @db.JsonB
  status                        PublishTaskStatus @default(pending)
  aiOptimized                   Json?             @map("ai_optimized") @db.JsonB
  aiOptions                     Json?             @map("ai_options") @db.JsonB
  pricingStrategy               Json?             @map("pricing_strategy") @db.JsonB
  skuSnapshot                   Json?             @map("sku_snapshot") @db.JsonB
  categoryPropertySnapshot      Json?             @map("category_property_snapshot") @db.JsonB
  categoryQualificationSnapshot Json?             @map("category_qualification_snapshot") @db.JsonB
  publishExternalIds            Json?             @map("publish_external_ids") @db.JsonB
  errorMsg                      String?           @map("error_msg") @db.Text
  createdAt                     DateTime          @default(now()) @map("created_at")
  finishedAt                    DateTime?         @map("finished_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct     SourceProduct      @relation(fields: [sourceProductId], references: [id])
  publishedProducts PublishedProduct[]
  job               PublishJob?

  @@unique([userId, clientRequestId], map: "uk_publish_tasks_user_client_request")
  @@index([userId, status])
  @@map("publish_tasks")
}

model PublishJob {
  id          BigInt           @id @default(autoincrement())
  taskId      BigInt           @unique @map("task_id")
  status      PublishJobStatus @default(queued)
  attempts    Int              @default(0)
  maxAttempts Int              @default(3) @map("max_attempts")
  nextRunAt   DateTime         @default(now()) @map("next_run_at")
  lockedAt    DateTime?        @map("locked_at")
  lockedBy    String?          @map("locked_by") @db.VarChar(128)
  lastError   String?          @map("last_error") @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  task PublishTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([lockedAt])
  @@map("publish_jobs")
}

enum PublishedProductStatus {
  online
  offline
  draft
  rejected
}

enum InventorySyncStatus {
  pending
  syncing
  retry_wait
  synced
  dead
}

model PublishedProduct {
  id                         BigInt                 @id @default(autoincrement())
  taskId                     BigInt                 @map("task_id")
  shopId                     BigInt                 @map("shop_id")
  sourceProductId            BigInt                 @map("source_product_id")
  platformProductId          String?                @map("platform_product_id") @db.VarChar(64)
  title                      String                 @db.VarChar(255)
  salePrice                  Decimal                @map("sale_price") @db.Decimal(10, 2)
  costPrice                  Decimal?               @map("cost_price") @db.Decimal(10, 2)
  skuSpecSnapshot            Json?                  @map("sku_spec_snapshot") @db.JsonB
  skuSpecFingerprint         String?                @map("sku_spec_fingerprint") @db.VarChar(64)
  skuSpecSyncedAt            DateTime?              @map("sku_spec_synced_at")
  skuPriceSnapshot           Json?                  @map("sku_price_snapshot") @db.JsonB
  skuInventorySnapshot       Json?                  @map("sku_inventory_snapshot") @db.JsonB
  priceSyncedAt              DateTime?              @map("price_synced_at")
  status                     PublishedProductStatus @default(online)
  categoryId                 String?                @map("category_id") @db.VarChar(64)
  mainImage                  String?                @map("main_image") @db.VarChar(512)
  inventorySyncStatus        InventorySyncStatus    @default(synced) @map("inventory_sync_status")
  inventoryFingerprint       String?                @map("inventory_fingerprint") @db.VarChar(64)
  inventoryTargetFingerprint String?                @map("inventory_target_fingerprint") @db.VarChar(64)
  inventoryVersion           Int                    @default(0) @map("inventory_version")
  inventoryTargetVersion     Int                    @default(0) @map("inventory_target_version")
  inventorySyncAttempts      Int                    @default(0) @map("inventory_sync_attempts")
  inventoryNextRunAt         DateTime?              @map("inventory_next_run_at")
  inventoryLockedAt          DateTime?              @map("inventory_locked_at")
  inventoryLockedBy          String?                @map("inventory_locked_by") @db.VarChar(128)
  inventoryLastSyncedAt      DateTime?              @map("inventory_last_synced_at")
  inventorySyncReason        String?                @map("inventory_sync_reason") @db.VarChar(64)
  inventorySyncError         String?                @map("inventory_sync_error") @db.Text
  editAttempts               Int                    @default(0) @map("edit_attempts")
  lastEditAttemptAt          DateTime?              @map("last_edit_attempt_at")
  lastEditedAt               DateTime?              @map("last_edited_at")
  lastEditError              String?                @map("last_edit_error") @db.Text
  mutationRevision           Int                    @default(1) @map("mutation_revision")
  platformStatusRaw          Int?                   @map("platform_status_raw")
  platformCheckStatusRaw     Int?                   @map("platform_check_status_raw")
  platformStatusSyncedAt     DateTime?              @map("platform_status_synced_at")
  platformStatusError        String?                @map("platform_status_error") @db.Text
  publishedAt                DateTime               @default(now()) @map("published_at")

  task           PublishTask                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shop           Shop                            @relation(fields: [shopId], references: [id])
  sourceProduct  SourceProduct                   @relation(fields: [sourceProductId], references: [id])
  orders         Order[]
  orderItems     OrderItem[]
  batchItems     ProductBatchItem[]
  sourceBindings PublishedProductSourceBinding[]

  @@unique([taskId, shopId], name: "uk_publish_task_shop", map: "published_products_task_id_shop_id_key")
  @@unique([shopId, platformProductId], name: "uk_shop_platform_product", map: "published_products_shop_platform_product_key")
  @@index([shopId])
  @@index([platformProductId])
  @@index([inventorySyncStatus, inventoryNextRunAt], map: "published_products_inventory_sync_status_inventory_next_run_at_")
  @@index([inventoryLockedAt])
  @@map("published_products")
}

// 已发布商品的版本化 1688 货源与 SKU 路由快照。current_slot=1 表示当前绑定，
// 历史绑定使用 NULL，从而允许同一商品保留多条历史但至多只有一条当前记录。
model PublishedProductSourceBinding {
  id                   BigInt    @id @default(autoincrement())
  publishedProductId   BigInt    @map("published_product_id")
  sourceProductId      BigInt    @map("source_product_id")
  revision             Int
  currentSlot          Int?      @map("current_slot")
  effectiveFrom        DateTime  @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")
  sourceOfferId        String    @map("source_offer_id") @db.VarChar(32)
  sourceSupplierId     String?   @map("source_supplier_id") @db.VarChar(32)
  sourceOnePieceDrop   Boolean   @map("source_one_piece_drop")
  sourceFingerprint    String    @map("source_fingerprint") @db.VarChar(64)
  inventoryFingerprint String    @map("inventory_fingerprint") @db.VarChar(64)
  inventoryVersion     Int       @map("inventory_version")
  skuRoutes            Json      @map("sku_routes") @db.JsonB
  bindingFingerprint   String    @map("binding_fingerprint") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at")

  publishedProduct PublishedProduct @relation(fields: [publishedProductId], references: [id], onDelete: Cascade)
  sourceProduct    SourceProduct    @relation(fields: [sourceProductId], references: [id], onDelete: Restrict)
