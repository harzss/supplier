enum AuditOutcome {
  success
  failure
}

model AuditLog {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt?      @map("user_id")
  action       String       @db.VarChar(128)
  method       String?      @db.VarChar(8)
  route        String?      @db.VarChar(255)
  resourceType String?      @map("resource_type") @db.VarChar(64)
  resourceId   String?      @map("resource_id") @db.VarChar(128)
  outcome      AuditOutcome
  statusCode   Int          @map("status_code")
  requestId    String       @map("request_id") @db.VarChar(64)
  ipHash       String?      @map("ip_hash") @db.VarChar(64)
  userAgent    String?      @map("user_agent") @db.VarChar(256)
  durationMs   Int          @map("duration_ms")
  metadata     Json?        @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_logs")
}

enum OperationalAlertSeverity {
  warning
  critical
}

enum OperationalAlertStatus {
  active
  resolved
}

model OperationalAlert {
  id             BigInt                   @id @default(autoincrement())
  key            String                   @unique @db.VarChar(160)
  type           String                   @db.VarChar(64)
