model AfterSaleCase {
  id                 BigInt                   @id @default(autoincrement())
  userId             BigInt                   @map("user_id")
  orderId            BigInt                   @unique(map: "after_sale_cases_order_id_key") @map("order_id")
  status             AfterSaleCaseStatus      @default(open)
  waitingOn          AfterSaleWaitingOn       @default(merchant) @map("waiting_on")
  priority           ExceptionPriority        @default(high)
  sourceActive       Boolean                  @default(true) @map("source_active")
  sourceFingerprint  String                   @map("source_fingerprint") @db.VarChar(64)
  sourceRevision     Int                      @default(1) @map("source_revision")
  stateRevision      Int                      @default(1) @map("state_revision")
  occurrences        Int                      @default(1)
  assigneeUserId     BigInt?                  @map("assignee_user_id")
  firstDetectedAt    DateTime                 @default(now()) @map("first_detected_at")
  lastObservedAt     DateTime                 @default(now()) @map("last_observed_at")
  nextActionDueAt    DateTime                 @map("next_action_due_at")
  platformDeadlineAt DateTime?                @map("platform_deadline_at")
  resolutionCode     AfterSaleResolutionCode? @map("resolution_code")
  resolutionNote     String?                  @map("resolution_note") @db.Text
  closedAt           DateTime?                @map("closed_at")
  closedByUserId     BigInt?                  @map("closed_by_user_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user     User                    @relation("AfterSaleCaseOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?                   @relation("AfterSaleCaseAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  closedBy User?                   @relation("AfterSaleCaseClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  order    Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items    AfterSaleCaseItem[]
  links    AfterSalePurchaseLink[]
  events   AfterSaleCaseEvent[]

