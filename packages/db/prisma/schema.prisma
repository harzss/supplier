  @@unique([publishedProductId, revision], name: "uk_published_product_source_binding_revision", map: "uk_published_product_source_binding_revision")
  @@unique([publishedProductId, currentSlot], name: "uk_published_product_current_source_binding", map: "uk_published_product_current_source_binding")
  @@index([publishedProductId, effectiveFrom, effectiveTo], map: "published_product_source_bindings_effective_interval_idx")
  @@index([sourceProductId])
  @@map("published_product_source_bindings")
}

// ----- 批量商品经营 -----

enum ProductBatchAction {
  edit_title
  edit_price
  edit_sku
  sync_inventory
  online
  offline
  change_source
  cleanup
}

enum ProductBatchTaskStatus {
  preview
  queued
  running
  cancelling
  cancelled
  partial
  succeeded
  failed
}

enum ProductBatchItemStatus {
  pending
  running
  retry_wait
  succeeded
  failed
  skipped
  cancelled
}

// 物化后的批量操作预览；确认后由 item 级队列执行，避免整批重试。
model ProductBatchTask {
  id                 BigInt                 @id @default(autoincrement())
  userId             BigInt                 @map("user_id")
  clientRequestId    String                 @map("client_request_id") @db.Uuid
  requestFingerprint String                 @map("request_fingerprint") @db.VarChar(64)
  action             ProductBatchAction
  status             ProductBatchTaskStatus @default(preview)
  stateRevision      Int                    @default(1) @map("state_revision")
  previewRevision    Int                    @default(1) @map("preview_revision")
  cancelRequestedAt  DateTime?              @map("cancel_requested_at")
  confirmedAt        DateTime?              @map("confirmed_at")
  startedAt          DateTime?              @map("started_at")
  finishedAt         DateTime?              @map("finished_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ProductBatchItem[]

  @@unique([userId, clientRequestId], name: "uk_product_batch_user_client_request", map: "product_batch_tasks_user_client_request_key")
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("product_batch_tasks")
}

model ProductBatchItem {
  id                       BigInt                 @id @default(autoincrement())
  taskId                   BigInt                 @map("task_id")
  publishedProductId       BigInt                 @map("published_product_id")
  ordinal                  Int
  status                   ProductBatchItemStatus @default(pending)
  expectedMutationRevision Int                    @map("expected_mutation_revision")
  beforeSnapshot           Json                   @map("before_snapshot") @db.JsonB
  desiredSnapshot          Json                   @map("desired_snapshot") @db.JsonB
  result                   Json?                  @db.JsonB
  errorCode                String?                @map("error_code") @db.VarChar(64)
  errorMessage             String?                @map("error_message") @db.Text
  attempts                 Int                    @default(0)
  maxAttempts              Int                    @default(3) @map("max_attempts")
  nextRunAt                DateTime               @default(now()) @map("next_run_at")
  lockedAt                 DateTime?              @map("locked_at")
  lockedBy                 String?                @map("locked_by") @db.VarChar(128)
  startedAt                DateTime?              @map("started_at")
  finishedAt               DateTime?              @map("finished_at")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  task             ProductBatchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  publishedProduct PublishedProduct @relation(fields: [publishedProductId], references: [id])

  @@unique([taskId, publishedProductId], name: "uk_product_batch_task_product", map: "product_batch_items_task_product_key")
  @@index([taskId, status])
  @@index([status, nextRunAt])
  @@index([lockedAt])
  @@map("product_batch_items")
}

// ----- 1688 批量货源采集 -----

// 采集任务复用批量商品任务/条目状态枚举，但使用独立表：采集条目在执行前并不存在
// PublishedProduct，不能复用 product_batch_items 的强外键语义。
model SourceImportTask {
  id                 BigInt                 @id @default(autoincrement())
  userId             BigInt                 @map("user_id")
  buyerShopId        BigInt?                @map("buyer_shop_id")
  clientRequestId    String                 @map("client_request_id") @db.Uuid
  requestFingerprint String                 @map("request_fingerprint") @db.VarChar(64)
  status             ProductBatchTaskStatus @default(preview)
  stateRevision      Int                    @default(1) @map("state_revision")
  previewRevision    Int                    @default(1) @map("preview_revision")
  cancelRequestedAt  DateTime?              @map("cancel_requested_at")
  confirmedAt        DateTime?              @map("confirmed_at")
  startedAt          DateTime?              @map("started_at")
  finishedAt         DateTime?              @map("finished_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyerShop Shop?              @relation("SourceImportBuyerShop", fields: [buyerShopId], references: [id], onDelete: Restrict)
  items     SourceImportItem[]

  @@unique([userId, clientRequestId], name: "uk_source_import_user_client_request", map: "source_import_tasks_user_client_request_key")
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([buyerShopId])
  @@map("source_import_tasks")
}

model SourceImportItem {
  id                  BigInt                 @id @default(autoincrement())
  taskId              BigInt                 @map("task_id")
  offerId             String                 @map("offer_id") @db.VarChar(32)
  ordinal             Int
  sourceProductId     BigInt?                @map("source_product_id")
  userSourceProductId BigInt?                @map("user_source_product_id")
  status              ProductBatchItemStatus @default(pending)
  beforeSnapshot      Json                   @map("before_snapshot") @db.JsonB
  result              Json?                  @db.JsonB
  errorCode           String?                @map("error_code") @db.VarChar(64)
  errorMessage        String?                @map("error_message") @db.Text
  attempts            Int                    @default(0)
  maxAttempts         Int                    @default(3) @map("max_attempts")
  nextRunAt           DateTime               @default(now()) @map("next_run_at")
  lockedAt            DateTime?              @map("locked_at")
  lockedBy            String?                @map("locked_by") @db.VarChar(128)
  startedAt           DateTime?              @map("started_at")
  finishedAt          DateTime?              @map("finished_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  task              SourceImportTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sourceProduct     SourceProduct?     @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)
  userSourceProduct UserSourceProduct? @relation(fields: [userSourceProductId], references: [id], onDelete: SetNull)

  @@unique([taskId, offerId], name: "uk_source_import_task_offer", map: "source_import_items_task_offer_key")
  @@index([taskId, status])
  @@index([status, nextRunAt])
  @@index([lockedAt])
  @@index([sourceProductId])
  @@index([userSourceProductId])
  @@map("source_import_items")
}

// ----- 订单 -----

enum OrderStatus {
  paid
  purchasing
  shipped
  received
  refunded
  closed
}

enum OrderAfterSaleStatus {
  none
  pending
  partial_refund
  refunded
  failed
}

enum OrderPartialRefundDisposition {
  none
  continue_remaining
  stop_all
}

model Order {
  id                           BigInt                        @id @default(autoincrement())
  shopId                       BigInt                        @map("shop_id")
  publishedProductId           BigInt?                       @map("published_product_id")
  platformOrderId              String                        @map("platform_order_id") @db.VarChar(64)
  buyerNick                    String?                       @map("buyer_nick") @db.VarChar(64)
  receiverName                 String?                       @map("receiver_name") @db.VarChar(64)
  receiverNameEnc              String?                       @map("receiver_name_enc") @db.VarChar(256)
  receiverPhoneEnc             String?                       @map("receiver_phone_enc") @db.VarChar(256)
  receiverAddressEnc           String?                       @map("receiver_address_enc") @db.Text
  receiverAddressDetailEnc     String?                       @map("receiver_address_detail_enc") @db.Text
  skuInfo                      Json                          @map("sku_info") @db.JsonB
  amount                       Decimal                       @db.Decimal(10, 2)
  status                       OrderStatus
  afterSaleStatus              OrderAfterSaleStatus          @default(none) @map("after_sale_status")
  afterSaleSyncedAt            DateTime?                     @map("after_sale_synced_at")
  partialRefundDisposition     OrderPartialRefundDisposition @default(none) @map("partial_refund_disposition")
  partialRefundFingerprint     String?                       @map("partial_refund_fingerprint") @db.VarChar(64)
  partialRefundDispositionAt   DateTime?                     @map("partial_refund_disposition_at")
  partialRefundDispositionNote String?                       @map("partial_refund_disposition_note") @db.Text
  refundAmount                 Decimal?                      @map("refund_amount") @db.Decimal(10, 2)
  refundAmountFingerprint      String?                       @map("refund_amount_fingerprint") @db.VarChar(64)
  refundAmountConfirmedAt      DateTime?                     @map("refund_amount_confirmed_at")
  refundAmountNote             String?                       @map("refund_amount_note") @db.Text
  paidAt                       DateTime?                     @map("paid_at")

  shop             Shop                   @relation(fields: [shopId], references: [id])
  publishedProduct PublishedProduct?      @relation(fields: [publishedProductId], references: [id])
  purchaseOrders   PurchaseOrder[]
  items            OrderItem[]
  logisticsRepairs OrderLogisticsRepair[]
  afterSaleCase    AfterSaleCase?

  @@unique([shopId, platformOrderId])
  @@index([status])
  @@index([afterSaleStatus])
  @@map("orders")
}

model OrderItem {
  id                  BigInt   @id @default(autoincrement())
  orderId             BigInt   @map("order_id")
  publishedProductId  BigInt?  @map("published_product_id")
  platformOrderItemId String   @map("platform_order_item_id") @db.VarChar(64)
  platformProductId   String?  @map("platform_product_id") @db.VarChar(64)
  platformSkuId       String   @map("platform_sku_id") @db.VarChar(64)
  sourceOfferId       String?  @map("source_offer_id") @db.VarChar(32)
  sourceSupplierId    String?  @map("source_supplier_id") @db.VarChar(32)
  sourceSpecId        String?  @map("source_spec_id") @db.VarChar(128)
  sourceSpecRequired  Boolean  @default(false) @map("source_spec_required")
  sourceBindingId     BigInt?  @map("source_binding_id")
  sourceUnitCost      Decimal? @map("source_unit_cost") @db.Decimal(10, 2)
  sourceOnePieceDrop  Boolean? @map("source_one_piece_drop")
  afterSaleStatusRaw  Int?     @map("after_sale_status_raw")
  afterSaleTypeRaw    Int?     @map("after_sale_type_raw")
  refundStatusRaw     Int?     @map("refund_status_raw")
  title               String   @db.VarChar(255)
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(10, 2)
  specs               Json?    @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  order              Order                          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  publishedProduct   PublishedProduct?              @relation(fields: [publishedProductId], references: [id], onDelete: SetNull)
  sourceBinding      PublishedProductSourceBinding? @relation(fields: [sourceBindingId], references: [id], onDelete: SetNull)
  purchaseOrderItem  PurchaseOrderItem?
  shipmentItems      PurchaseShipmentItem[]
  afterSaleCaseItems AfterSaleCaseItem[]

  @@unique([orderId, platformOrderItemId], name: "uk_order_platform_item")
  @@unique([id, orderId], name: "uk_order_item_id_order", map: "uk_order_item_id_order")
  @@index([sourceOfferId, sourceSpecId])
  @@index([sourceSupplierId])
  @@index([publishedProductId])
  @@index([sourceBindingId])
  @@map("order_items")
}

enum PurchaseOrderStatus {
  pending
  placed
  awaiting_payment
  paid
  shipped
  received
  failed
}

enum PurchaseExceptionStatus {
  none
  stopped
  action_required
  resolved
}

enum OrderLogisticsRepairStatus {
  pending
  running
  completed
}

model PurchaseOrder {
  id                      BigInt                  @id @default(autoincrement())
  orderId                 BigInt                  @map("order_id")
  buyerShopId             BigInt?                 @map("buyer_shop_id")
  supplierKey             String                  @map("supplier_key") @db.VarChar(64)
  outOrderId              String                  @unique @map("out_order_id") @db.VarChar(128)
  orderId1688             String?                 @unique @map("order_id_1688") @db.VarChar(64)
  paymentMode             String                  @default("manual") @map("payment_mode") @db.VarChar(16)
  purchaseCost            Decimal?                @map("purchase_cost") @db.Decimal(10, 2)
  reconciledCost          Decimal?                @map("reconciled_cost") @db.Decimal(10, 2)
  status                  PurchaseOrderStatus     @default(pending)
  trackingNo              String?                 @map("tracking_no") @db.VarChar(64)
  carrier                 String?                 @db.VarChar(64)
  failureReason           String?                 @map("failure_reason") @db.Text
  retryCount              Int                     @default(0) @map("retry_count")
  attemptNo               Int                     @default(1) @map("attempt_no")
  attemptStartedAt        DateTime                @default(now()) @map("attempt_started_at")
  priorIncurredCost       Decimal                 @default(0) @map("prior_incurred_cost") @db.Decimal(10, 2)
  retryEligible           Boolean                 @default(false) @map("retry_eligible")
  everShipped             Boolean                 @default(false) @map("ever_shipped")
  syncRevision            Int                     @default(0) @map("sync_revision")
  settledAuditNextAt      DateTime?               @map("settled_audit_next_at")
  exceptionStatus         PurchaseExceptionStatus @default(none) @map("exception_status")
  exceptionRevision       Int                     @default(0) @map("exception_revision")
  exceptionCode           String?                 @map("exception_code") @db.VarChar(64)
  exceptionReason         String?                 @map("exception_reason") @db.Text
  exceptionDetectedAt     DateTime?               @map("exception_detected_at")
  exceptionResolvedAt     DateTime?               @map("exception_resolved_at")
  exceptionResolutionNote String?                 @map("exception_resolution_note") @db.Text
  createdAt               DateTime                @default(now()) @map("created_at")

  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerShop        Shop?                   @relation("PurchaseBuyerShop", fields: [buyerShopId], references: [id], onDelete: SetNull)
  items            PurchaseOrderItem[]
  shipments        PurchaseShipment[]
  attempts         PurchaseOrderAttempt[]
  recoveries       PurchaseOrderRecovery[]
  logisticsRepairs OrderLogisticsRepair[]
  afterSaleLinks   AfterSalePurchaseLink[]

  @@unique([orderId, supplierKey], name: "uk_order_supplier_purchase")
  @@unique([id, orderId], name: "uk_purchase_order_id_order", map: "uk_purchase_order_id_order")
  @@index([orderId])
  @@index([buyerShopId])
  @@index([status])
  @@index([exceptionStatus])
  @@index([settledAuditNextAt])
  @@map("purchase_orders")
}

model PurchaseOrderAttempt {
  id              BigInt              @id @default(autoincrement())
  purchaseOrderId BigInt              @map("purchase_order_id")
  attemptNo       Int                 @map("attempt_no")
  outOrderId      String              @unique @map("out_order_id") @db.VarChar(128)
  orderId1688     String              @map("order_id_1688") @db.VarChar(64)
  status          PurchaseOrderStatus
  purchaseCost    Decimal?            @map("purchase_cost") @db.Decimal(10, 2)
