enum SubscriptionPlan {
  basic
  pro
  flagship
  enterprise
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model Subscription {
  id                    BigInt                             @id @default(autoincrement())
  userId                BigInt                             @map("user_id")
  plan                  SubscriptionPlan
  startDate             DateTime                           @map("start_date") @db.Date
