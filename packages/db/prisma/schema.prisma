  verifying
  closed
}

enum AfterSaleWaitingOn {
  merchant
  sales_platform
  supplier
  system
  none
}

enum AfterSaleResolutionCode {
  sales_rejected_or_withdrawn
  partial_refund_handled
  full_refund_handled
  price_protection_reconciled
  order_closed_handled
}

enum AfterSalePurchaseLinkStatus {
  not_required
  action_required
  waiting_external
  confirmed
  failed
}

enum AfterSalePurchaseAction {
  none
  cancel
  refund
  return_refund
  intercept
  accept_loss
  manual_review
}

enum AfterSalePurchaseResult {
